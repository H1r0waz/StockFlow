# npm run db:start generates project-only local credentials in ignored .env.
# Never copy credentials from another project. Leave this example secret-free.
DATABASE_URL=
TEST_DATABASE_URL=
WEB_ORIGIN=http://127.0.0.1:5173
PORT=3001

